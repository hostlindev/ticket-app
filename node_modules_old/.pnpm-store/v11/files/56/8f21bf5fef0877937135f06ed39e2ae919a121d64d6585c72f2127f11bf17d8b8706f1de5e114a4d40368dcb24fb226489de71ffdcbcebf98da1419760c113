@layer vuetify-components {
  .v-navigation-btn {
    position: relative;
    display: grid;
    grid-template-rows: 0fr;
    flex: none;
    width: 100%;
    padding-block: calc(6px + 32px + 4px) calc(56px - calc(6px + 32px + 4px));
    padding-inline: 0;
    border: none;
    background: none;
    color: rgba(var(--v-theme-on-surface), var(--v-medium-emphasis-opacity));
    text-align: start;
    text-decoration: none;
    outline: none;
    cursor: pointer;
    user-select: none;
    transition: grid-template-rows 0.22s cubic-bezier(0.2, 0.1, 0.4, 1), padding 0.22s cubic-bezier(0.2, 0.1, 0.4, 1), margin 0.22s cubic-bezier(0.2, 0.1, 0.4, 1);
  }
  .v-navigation-btn--disabled {
    opacity: var(--v-disabled-opacity);
    pointer-events: none;
  }
  .v-navigation-btn--active {
    color: rgba(var(--v-theme-on-surface), var(--v-high-emphasis-opacity));
  }
  .v-navigation-btn__pill {
    position: absolute;
    transition: top 0.22s cubic-bezier(0.2, 0.1, 0.4, 1);
    top: 0;
    inset-inline-start: 20px;
    display: flex;
    align-items: center;
    width: max-content;
    height: 56px;
    padding-inline: calc(16px + 24px + 8px) 16px;
    white-space: nowrap;
  }
  .v-navigation-btn__indicator,
  .v-navigation-btn__overlay {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    transition: top 0.22s cubic-bezier(0.2, 0.1, 0.4, 1), width 0.22s cubic-bezier(0.2, 0.1, 0.4, 1), height 0.22s cubic-bezier(0.2, 0.1, 0.4, 1);
  }
  .v-navigation-btn__indicator {
    background: currentColor;
    opacity: 0;
  }
  .v-navigation-btn--active .v-navigation-btn__indicator {
    opacity: var(--v-activated-opacity);
  }
  .v-navigation-btn__overlay {
    overflow: hidden;
  }
  .v-navigation-btn__overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    background: currentColor;
    opacity: 0;
    transition: opacity 0.1s cubic-bezier(0, 0, 0.2, 1);
    pointer-events: none;
  }
  .v-navigation-btn:hover .v-navigation-btn__overlay::after {
    opacity: var(--v-hover-opacity);
  }
  .v-navigation-btn:focus-visible .v-navigation-btn__overlay {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .v-navigation-btn:focus-visible .v-navigation-btn__overlay::after {
    opacity: var(--v-focus-opacity);
  }
  .v-navigation-btn:active .v-navigation-btn__overlay::after {
    opacity: var(--v-pressed-opacity);
  }
  .v-navigation-btn__icon {
    position: absolute;
    top: calc((56px - 24px) / 2);
    inset-inline-start: 16px;
    z-index: 1;
    display: flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    transition: top 0.22s cubic-bezier(0.2, 0.1, 0.4, 1);
  }
  .v-navigation-btn__icon .v-icon {
    --v-icon-size-multiplier: 1;
    font-size: 24px;
  }
  .v-navigation-btn__icon .v-badge:not(.v-badge--dot) .v-badge__badge {
    height: 16px;
    min-width: 16px;
    padding: 0 4px;
  }
  .v-navigation-btn__icon .v-badge:not(.v-badge--dot) .v-badge__badge {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.0454545455em;
    line-height: 1.4545454545;
    text-transform: none;
  }
  .v-navigation-btn__text {
    position: relative;
    transition: opacity 0.1s cubic-bezier(0, 0, 0.2, 1) 0.1s, transform 0.15s cubic-bezier(0.2, 0, 0, 1) 0.1s;
  }
  .v-navigation-btn__text {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.0071428571em;
    line-height: 1.4285714286;
    text-transform: none;
  }
  .v-navigation-btn__label {
    width: 88px;
    min-height: 0;
    margin-inline-start: calc(20px + (56px - 88px) / 2);
    overflow-wrap: break-word;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.1s cubic-bezier(0, 0, 0.2, 1), visibility 0s 0.1s;
  }
  .v-navigation-btn__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.0416666667em;
    line-height: 1.3333333333;
    text-transform: none;
  }
  .v-navigation-btn--stacked {
    grid-template-rows: 1fr;
    padding-bottom: 6px;
  }
  .v-navigation-btn--stacked + .v-navigation-btn--stacked {
    margin-top: 4px;
  }
  .v-navigation-btn--stacked .v-navigation-btn__indicator,
  .v-navigation-btn--stacked .v-navigation-btn__overlay {
    top: 6px;
    width: 56px;
    height: 32px;
  }
  .v-navigation-btn--stacked .v-navigation-btn__icon {
    top: calc(6px + (32px - 24px) / 2);
  }
  .v-navigation-btn--stacked .v-navigation-btn__text {
    opacity: 0;
    transform: translateX(calc(-1 * 10px));
    pointer-events: none;
    transition: opacity 0.1s cubic-bezier(0, 0, 0.2, 1), transform 0s 0.1s;
  }
  .v-locale--is-rtl.v-navigation-btn--stacked .v-navigation-btn__text, .v-locale--is-rtl .v-navigation-btn--stacked .v-navigation-btn__text {
    transform: translateX(10px);
  }
  .v-navigation-btn--stacked .v-navigation-btn__label {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.1s cubic-bezier(0, 0, 0.2, 1), visibility 0s;
  }
  .v-navigation-btn--stacked.v-navigation-btn--labels-none .v-navigation-btn__label,
  .v-navigation-btn--stacked.v-navigation-btn--labels-selected:not(.v-navigation-btn--active) .v-navigation-btn__label {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.1s cubic-bezier(0, 0, 0.2, 1), visibility 0s 0.1s;
  }
  .v-navigation-btn--stacked.v-navigation-btn--labels-selected:not(.v-navigation-btn--active) .v-navigation-btn__pill {
    top: calc(50% - 6px - 32px / 2);
  }
  .v-navigation-btn--stacked.v-navigation-btn--labels-none {
    grid-template-rows: 0fr;
    padding-block: 56px 0;
  }
  .v-navigation-btn--stacked.v-navigation-btn--labels-none .v-navigation-btn__indicator,
  .v-navigation-btn--stacked.v-navigation-btn--labels-none .v-navigation-btn__overlay {
    top: 0;
    height: 56px;
  }
  .v-navigation-btn--stacked.v-navigation-btn--labels-none .v-navigation-btn__icon {
    top: calc((56px - 24px) / 2);
  }
  .v-bottom-navigation .v-navigation-btn {
    flex: 1 1 0;
    width: auto;
    min-width: 0;
    height: 100%;
    margin: 0;
  }
  .v-bottom-navigation .v-navigation-btn .v-navigation-btn__pill {
    inset-inline: 0;
    margin-inline: auto;
  }
  .v-bottom-navigation .v-navigation-btn .v-navigation-btn__label {
    width: auto;
    margin-inline: 0;
  }
  .v-bottom-navigation .v-navigation-btn.v-navigation-btn--stacked .v-navigation-btn__pill {
    width: 56px;
    padding: 0;
  }
  .v-bottom-navigation .v-navigation-btn.v-navigation-btn--stacked.v-navigation-btn--labels-none .v-navigation-btn__pill {
    top: calc(50% - 56px / 2);
  }
  .v-bottom-navigation .v-navigation-btn:not(.v-navigation-btn--stacked) {
    flex: 0 1 168px;
    min-width: max-content;
    padding: 0;
  }
  .v-bottom-navigation .v-navigation-btn:not(.v-navigation-btn--stacked) .v-navigation-btn__pill {
    top: calc(50% - 40px / 2);
    height: 40px;
    padding-inline-start: calc(16px + 24px + 4px);
  }
  .v-bottom-navigation .v-navigation-btn:not(.v-navigation-btn--stacked) .v-navigation-btn__icon {
    top: calc((40px - 24px) / 2);
  }
  .v-bottom-navigation .v-navigation-btn:not(.v-navigation-btn--stacked) .v-navigation-btn__text {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.0416666667em;
    line-height: 1.3333333333;
    text-transform: none;
  }
  .v-bottom-navigation--grow .v-navigation-btn:not(.v-navigation-btn--stacked) {
    flex: 1 1 0;
  }
  @media (forced-colors: active) {
    .v-navigation-btn--active .v-navigation-btn__indicator {
      border: 2px solid;
      background: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v-navigation-btn,
    .v-navigation-btn .v-navigation-btn__pill,
    .v-navigation-btn .v-navigation-btn__indicator,
    .v-navigation-btn .v-navigation-btn__overlay,
    .v-navigation-btn .v-navigation-btn__icon,
    .v-navigation-btn .v-navigation-btn__text,
    .v-navigation-btn .v-navigation-btn__label {
      transition: none;
    }
  }
}